# MeterSphere API 配置
# 复制此文件为 .env 并填写实际值

# 必需环境变量
METERSPHERE_BASE_URL=http://172.16.30.91:8081
METERSPHERE_ACCESS_KEY=zPiRqA6oLPcCmiw0
METERSPHERE_SECRET_KEY=xhlV689EkRfsWen5

# 可选环境变量
METERSPHERE_PROJECT_ID=17594539687583744
METERSPHERE_ORGANIZATION_ID=100001
METERSPHERE_HEADERS_JSON={"X-Custom-Header":"value"}
METERSPHERE_PROTOCOLS_JSON='["HTTP"]'

# 重要: 避免使用硬编码的模板和版本ID
# 设置以下环境变量来覆盖脚本中的硬编码值
METERSPHERE_DEFAULT_TEMPLATE_ID=17594556867452952
METERSPHERE_DEFAULT_VERSION_ID=your_version_id

# 安全警告:
# 1. METERSPHERE_SECRET_KEY 仅在本地用于签名，不会传输到服务器
# 2. METERSPHERE_HEADERS_JSON 可以注入任意HTTP头，请谨慎使用
# 3. 使用最小权限的API密钥，避免在生产环境中使用高权限密钥

# 缺陷提交（MeterSphere v3.x）
# 不设置时使用项目的默认缺陷模板；多个模板或没有默认模板时，使用命令行 --template 指定。
# METERSPHERE_BUG_TEMPLATE_ID=your_bug_template_id
# 以下路径仅用于已确认目标实例路由差异时覆盖。默认值适用于 MeterSphere v3.x。
METERSPHERE_BUG_ADD_PATH=/bug/add
METERSPHERE_BUG_DETAIL_PATH=/bug/get/{id}
METERSPHERE_BUG_ATTACHMENT_LIST_PATH=/bug/attachment/list/{id}
METERSPHERE_BUG_TEMPLATE_OPTION_PATH=/bug/template/option/{projectId}
METERSPHERE_BUG_TEMPLATE_DETAIL_PATH=/bug/template/detail
# 默认拒绝 HTTP，避免明文传输 API 签名、缺陷内容和附件。可信内网实例如必须使用 HTTP，才显式开启：
METERSPHERE_ALLOW_INSECURE_HTTP=true
