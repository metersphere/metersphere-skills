# MeterSphere API 配置
# 复制为同目录 .env 并填写实际值。ms.sh 和 ms_bug.py 会读取 skills/.env。

METERSPHERE_BASE_URL=https://your-metersphere-instance.example
METERSPHERE_ACCESS_KEY=your_access_key_here
METERSPHERE_SECRET_KEY=your_secret_key_here

# 可选：默认项目和组织
# METERSPHERE_PROJECT_ID=your_default_project_id
# METERSPHERE_ORGANIZATION_ID=100001
# METERSPHERE_HEADERS_JSON={"X-Custom-Header":"value"}
# METERSPHERE_PROTOCOLS_JSON='["HTTP"]'

# 可选：缺陷提交（MeterSphere v3.x）
# METERSPHERE_BUG_TEMPLATE_ID=your_bug_template_id
# METERSPHERE_BUG_ADD_PATH=/bug/add
# METERSPHERE_BUG_DETAIL_PATH=/bug/get/{id}
# METERSPHERE_BUG_ATTACHMENT_LIST_PATH=/bug/attachment/list/{id}
# METERSPHERE_BUG_TEMPLATE_OPTION_PATH=/bug/template/option/{projectId}
# METERSPHERE_BUG_TEMPLATE_DETAIL_PATH=/bug/template/detail

# 默认拒绝 HTTP，避免明文传输 API 签名、缺陷内容和附件。
# 可信内网实例如必须使用 HTTP，才显式开启：
# METERSPHERE_ALLOW_INSECURE_HTTP=true
